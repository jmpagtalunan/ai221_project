    "csv_by_unit = features_df.reset_index().merge(gt_df, on=_KEY, how=\"left\").set_index(\"unit_id\")[\"csv_void_ratio\"]\n",
    "\n",
    "fig, axes = plt.subplots(len(LED_TYPES), 4, figsize=(13, 3.3 * len(LED_TYPES)))\n",
    "for r, t in enumerate(LED_TYPES):\n",
    "    for c, s in enumerate(VOID_SAMPLES[t]):\n",
    "        vis, n = draw_void_outlines(s[\"img\"], s[\"mask\"])\n",
    "        axes[r, c].imshow(cv2.cvtColor(vis, cv2.COLOR_BGR2RGB)); axes[r, c].axis(\"off\")\n",
    "        axes[r, c].set_title(f\"{s['unit_id']}\\n{n} voids, {100*s['void_ratio']:.1f} %  (CSV {100*csv_by_unit.get(s['unit_id'], np.nan):.1f} %)\", fontsize=8)\n",
    "plt.tight_layout(); plt.show()"
   ]
