   "source": [
    "cmp_df = features_df.reset_index().merge(gt_df, on=_KEY, how=\"left\")\n",
    "cmp_df = cmp_df[(cmp_df.image_missing == 0) & cmp_df.csv_void_ratio.notna()]\n",
    "\n",
    "summary = cmp_df.groupby(\"led_type\").apply(lambda g: pd.Series({\n",
    "    \"n\": len(g),\n",
    "    \"ours_mean_%\": 100 * g.void_ratio.mean(),\n",
    "    \"csv_mean_%\": 100 * g.csv_void_ratio.mean(),\n",
    "    \"mean_abs_err_%pt\": 100 * (g.void_ratio - g.csv_void_ratio).abs().mean(),\n",
    "    \"pearson_r\": g.void_ratio.corr(g.csv_void_ratio),\n",
    "    \"spearman_rho\": g.void_ratio.corr(g.csv_void_ratio, method=\"spearman\"),\n",
    "}), include_groups=False)\n",
    "print(summary.round(2).to_string())\n",
    "print(f\"\\nall LEDs: r = {cmp_df.void_ratio.corr(cmp_df.csv_void_ratio):.2f}, \"\n",
    "      f\"mean abs. error = {100*(cmp_df.void_ratio - cmp_df.csv_void_ratio).abs().mean():.2f} %-points\")\n",
    "\n",
    "fig, axes = plt.subplots(3, 3, figsize=(11, 11))\n",
    "for ax, t in zip(axes.flat, LED_TYPES):\n",
    "    g = cmp_df[cmp_df.led_type == t]\n",
    "    ax.scatter(100 * g.csv_void_ratio, 100 * g.void_ratio, s=8)\n",
    "    m = 100 * max(g.csv_void_ratio.max(), g.void_ratio.max())\n",
    "    ax.plot([0, m], [0, m], \"k--\", lw=0.7)\n",
    "    ax.set_title(f\"{t}   r = {summary.loc[t, 'pearson_r']:.2f}\")\n",
    "    ax.set_xlabel(\"CSV void ratio [%]\"); ax.set_ylabel(\"this notebook [%]\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
