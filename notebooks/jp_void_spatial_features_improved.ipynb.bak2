    "ax[0].set_title(\"Electrical-pad void area fraction (all LEDs)\")\n",
    "ax[0].set_xlabel(\"fraction\"); ax[0].set_ylabel(\"count\")\n",
    "features_df[\"thermal_void_area_frac\"].dropna().hist(bins=40, ax=ax[1], color=\"orange\")\n",
