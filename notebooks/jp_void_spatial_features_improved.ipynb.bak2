   "source": [
    "VOID_SAMPLES = {}      # a few DUTs per LED type, kept for the outline gallery below\n",
    "\n",
    "\n",
    "def process_led_type(led_type, verbose=False):\n",
    "    c = build_void_context(led_type)\n",
    "    rows, masks = [], []\n",
    "    for i, mrow in enumerate(c[\"meta\"]):\n",
    "        mask = extract_void_mask(c, i)\n",
    "        row = led_feature_vector(mask, c[\"pads\"], mrow, pad_masks=c[\"pad_masks\"])\n",
    "        row.update(void_stats(c, i, mask))\n",
    "        row[\"image_missing\"] = int(not c[\"ok\"][i])\n",
    "        if not c[\"ok\"][i]:                                   # placeholder picture: no features\n",
    "            for k in row:\n",
    "                if k.startswith((\"thermal_\", \"electrical_mean_\")):\n",
    "                    row[k] = np.nan\n",
    "        rows.append(row); masks.append(mask)\n",
    "    ratio = np.array([r[\"void_ratio\"] for r in rows])\n",
    "    order = np.argsort(np.nan_to_num(ratio, nan=-1))\n",
    "    order = order[np.isfinite(ratio[order])]\n",
    "    pick = [int(order[int(q * (len(order) - 1))]) for q in (0.1, 0.5, 0.9, 1.0)]     # low / median / high / highest\n",
    "    VOID_SAMPLES[led_type] = [dict(unit_id=rows[i][\"unit_id\"], img=np.clip(c[\"aligned\"][i], 0, 255).astype(np.uint8),\n",
    "                                   mask=masks[i], void_ratio=ratio[i]) for i in pick]\n",
    "    if verbose:\n",
    "        print(f\"  {led_type}: {len(rows)} imgs, {len(c['pads'])} pads, {int((~c['ok']).sum())} placeholder(s), \"\n",
    "              f\"mean void ratio {100*np.nanmean(ratio):.2f} %\")\n",
    "    return rows\n",
    "\n",
    "\n",
    "all_rows = []\n",
    "for t in LED_TYPES:\n",
    "    all_rows.extend(process_led_type(t, verbose=True))\n",
    "\n",
    "features_df = pd.DataFrame(all_rows).set_index(\"unit_id\")\n",
    "print(f\"\\nFeature matrix: {features_df.shape}\")\n",
    "features_df.head()"
   ]
  },
