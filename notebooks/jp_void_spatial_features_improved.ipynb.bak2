  {
   "cell_type": "markdown",
   "id": "6d3cf347",
   "metadata": {},
   "source": [
    "Pads are the **darkest** connected components in the reference. X-ray physics: metal (pad + solder) attenuates X-rays, so pad regions appear darker than the surrounding board/air (Part I §III.A: *\"voids appear brighter in the X-ray image since more radiation can pass through the specimen due to missing metallic material\"* — the inverse applies to metal). Workflow per LED type:\n",
    "\n",
    "1. **Dark-pixel mask** — Otsu INV by default; for troublesome types (e.g. VTF2, where the die competes with pad darkness) use a per-type percentile or intensity override via `PAD_THRESH_OVERRIDE`.\n",
    "2. **Iterative erosion** (3×3 kernel, up to `MAX_EROSION_OVERRIDE[led_type]` passes; default 8, 20 for VTF2) — splits touching pads into separate connected components without needing a physically visible gap.\n",
    "3. **Connected components** → keep the N biggest where N ∈ {2, 3} depending on LED type.\n",
    "4. **Dilate back + clip** against the original dark-pixel mask — recovers each pad's full extent without bleeding into neighbors.\n",
    "5. **Assign roles:** 3-pad LEDs → largest = thermal, others = electrical; 2-pad LEDs → both electrical.\n",
    "\n",
    "This replaces hand-coded pad layouts and adapts to each LED type's image size and geometry automatically. Per Part I §II.A text (and Part II Table I pad-count row): FC-SP1, FC-SP2, FC-GB3 are 2-pad designs; the rest are 3-pad. The thermal pad is the largest for 3-pad types (Part II §II.A: *\"for three-pad designs, the thermal pad is typically bigger compared to the electrical pads\"*)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 134,
   "id": "302cfc24",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-15T15:41:31.027910Z",
     "iopub.status.busy": "2026-11-15T15:41:31.027611Z",
     "iopub.status.idle": "2026-11-15T15:41:31.280937Z",
     "shell.execute_reply": "2026-11-15T15:41:31.280026Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "FC-SP3 detected pads:\n",
      "  (34, 28, 190, 116, 'thermal', 13500)\n",
      "  (33, 151, 102, 239, 'electrical', 5790)\n",
      "  (122, 151, 190, 239, 'electrical', 5784)\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1210x385 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Pad counts per LED type (Part I §II.A text; Part II Table I)\n",
    "PAD_COUNT = {\n",
    "    \"FC-SP1\": 2, \"FC-SP2\": 2, \"FC-GB3\": 2,\n",
    "    \"FC-SP3\": 3, \"FC-SP4\": 3, \"FC-GB1\": 3, \"FC-GB2\": 3,\n",
    "    \"VTF1\":   3, \"VTF2\":   3,\n",
    "}\n",
    "\n",
    "# Per-LED-type threshold override (controls initial dark-pixel mask).\n",
    "# Each entry: percentile value = darkest N% of pixels become pad candidates.\n",
    "#   - Lower value  → stricter (captures only the darkest pixels)\n",
    "#   - Higher value → looser (captures more mid-tone features)\n",
    "# Starting values: 30% for most, 20% for VTF2 (die competes with pads).\n",
    "PAD_THRESH_OVERRIDE = {\n",
    "    \"FC-SP1\": {\"mode\": \"percentile\", \"value\": 20},\n",
    "    # \"FC-SP2\": {\"mode\": \"percentile\", \"value\": 30},\n",
    "    \"FC-SP3\": {\"mode\": \"intensity\", \"value\": 15},\n",
    "    \"FC-SP4\": {\"mode\": \"percentile\", \"value\": 40},\n",
    "    \"FC-GB1\": {\"mode\": \"percentile\", \"value\": 40},\n",
    "    \"FC-GB2\": {\"mode\": \"percentile\", \"value\": 30},\n",
    "    \"FC-GB3\": {\"mode\": \"percentile\", \"value\": 30},\n",
    "    \"VTF1\":   {\"mode\": \"percentile\", \"value\": 42},\n",
    "    \"VTF2\":   {\"mode\": \"percentile\", \"value\": 40},\n",
    "}\n",
    "\n",
    "# Per-LED-type erosion budget (how many 3×3 erosion passes before giving up on splitting).\n",
    "# Higher = more aggressive splitting of fused pads. Default 8 for most; 20 for VTF2.\n",
    "MAX_EROSION_OVERRIDE = {\n",
    "    \"FC-SP1\": 8,\n",
    "    \"FC-SP2\": 8,\n",
    "    \"FC-SP3\": 8,\n",
    "    \"FC-SP4\": 8,\n",
    "    \"FC-GB1\": 8,\n",
    "    \"FC-GB2\": 8,\n",
    "    \"FC-GB3\": 8,\n",
    "    \"VTF1\":   8,\n",
    "    \"VTF2\":   20,\n",
    "}\n",
    "\n",
    "def _initial_pad_mask(reference, led_type):\n",
    "    \"\"\"Return the initial dark-pixel mask using Otsu INV, or a per-type percentile override.\"\"\"\n",
    "    override = PAD_THRESH_OVERRIDE.get(led_type)\n",
    "    if override and override[\"mode\"] == \"percentile\":\n",
    "        thresh_val = int(np.percentile(reference, override[\"value\"]))\n",
    "        _, mask = cv2.threshold(reference, thresh_val, 255, cv2.THRESH_BINARY_INV)\n",
    "        return mask\n",
    "    _, mask = cv2.threshold(reference, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)\n",
    "    return mask\n",
    "\n",
    "\n",
    "def detect_pads(reference, led_type, min_area_frac=0.02, max_erosion=None):\n",
    "    \"\"\"Find pad bounding boxes in the reference image.\n",
    "\n",
    "    X-ray physics: pads are DARKER than the surrounding board (Part I §III.A).\n",
    "\n",
    "    Algorithm:\n",
    "      1. Dark-pixel mask (Otsu INV, or percentile threshold for types in PAD_THRESH_OVERRIDE).\n",
    "      2. Erode iteratively until we have >= n_expected components.\n",
    "      3. For each kept component, dilate back by the same number of erosions AND\n",
    "         clip with the original mask so the bbox does not bleed into neighbors.\n",
    "\n",
    "    Returns (pads_list, per_pad_masks).\n",
    "    \"\"\"\n",
    "    n_expected = PAD_COUNT.get(led_type, 3)\n",
    "    if max_erosion is None:\n",
    "        max_erosion = MAX_EROSION_OVERRIDE.get(led_type, 8)\n",
    "    min_area = int(min_area_frac * reference.size)\n",
    "    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (3, 3))\n",
    "\n",
    "    # 1. Initial dark-pixel mask\n",
    "    mask0 = _initial_pad_mask(reference, led_type)\n",
    "\n",
    "    # 2. Iterative erosion until components split\n",
    "    mask = mask0.copy()\n",
    "    erosions_used = 0\n",
    "    regions = []\n",
    "    for i in range(max_erosion + 1):\n",
    "        lbl = label(mask > 0)\n",
    "        regions = [r for r in regionprops(lbl) if r.area >= min_area]\n",
    "        if len(regions) >= n_expected:\n",
    "            erosions_used = i\n",
    "            break\n",
    "        mask = cv2.erode(mask, kernel)\n",
    "\n",
    "    # 3. Top-N by area\n",
    "    regions = sorted(regions, key=lambda r: r.area, reverse=True)[:n_expected]\n",
    "\n",
    "    # 4. Dilate back + clip with original mask\n",
    "    pads = []\n",
    "    per_pad_masks = []\n",
    "    for i, r in enumerate(regions):\n",
    "        seed = np.zeros_like(mask)\n",
    "        for (y, x) in r.coords:\n",
    "            seed[y, x] = 255\n",
    "        if erosions_used > 0:\n",
    "            seed = cv2.dilate(seed, kernel, iterations=erosions_used)\n",
    "            seed = cv2.bitwise_and(seed, mask0)\n",
    "        ys, xs = np.nonzero(seed)\n",
    "        if len(ys) == 0:\n",
    "            continue\n",
    "        y0, y1 = int(ys.min()), int(ys.max() + 1)\n",
    "        x0, x1 = int(xs.min()), int(xs.max() + 1)\n",
    "        role = \"thermal\" if (n_expected == 3 and i == 0) else \"electrical\"\n",
    "        pads.append((x0, y0, x1, y1, role, int(seed.sum() / 255)))\n",
    "        per_pad_masks.append(seed)\n",
    "    return pads, per_pad_masks\n",
    "\n",
    "\n",
    "# --- Demo ---\n",
    "pads, pad_masks = detect_pads(reference, \"FC-SP3\")\n",
    "print(\"FC-SP3 detected pads:\")\n",
    "for p in pads:\n",
    "    print(\" \", p)\n",
    "\n",
    "_, otsu_only = cv2.threshold(reference, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)\n",
    "\n",
    "vis = cv2.cvtColor(reference, cv2.COLOR_GRAY2BGR)\n",
    "colors = [(0, 255, 0), (255, 150, 0), (200, 80, 255)]\n",
    "overlay = np.zeros_like(vis)\n",
    "for m, col in zip(pad_masks, colors):\n",
    "    overlay[m > 0] = col\n",
    "vis = cv2.addWeighted(vis, 0.65, overlay, 0.45, 0)\n",
    "for (x0, y0, x1, y1, role, _a), col in zip(pads, colors):\n",
    "    cv2.rectangle(vis, (x0, y0), (x1, y1), col, 2)\n",
    "    cv2.putText(vis, role[0].upper(), (x0 + 2, y0 + 14),\n",
    "                cv2.FONT_HERSHEY_SIMPLEX, 0.45, col, 1)\n",
    "\n",
    "fig, ax = plt.subplots(1, 3, figsize=(11, 3.5))\n",
    "\n",
    "ax[0].imshow(reference, cmap=\"gray\")\n",
    "ax[0].set_title(\"Reference (pads = dark)\")\n",
    "ax[0].axis(\"off\")\n",
    "\n",
    "ax[1].imshow(otsu_only, cmap=\"gray\")\n",
    "ax[1].set_title(\"Otsu INV (pre-erosion-split)\")\n",
    "ax[1].axis(\"off\")\n",
    "\n",
    "ax[2].imshow(cv2.cvtColor(vis, cv2.COLOR_BGR2RGB))\n",
    "ax[2].set_title(\"Detected pads (tight)\")\n",
    "ax[2].axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
