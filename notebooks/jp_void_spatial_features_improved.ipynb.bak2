    "fig, axes = plt.subplots(3, 3, figsize=(10, 10))\n",
    "for ax, t in zip(axes.flat, LED_TYPES):\n",
    "    imgs, _ = load_led_type(t)\n",
    "    ref, _ = compute_reference(imgs)\n",
    "    ps, _ = detect_pads(ref, t)\n",
    "    vis = cv2.cvtColor(ref, cv2.COLOR_GRAY2BGR)\n",
    "    for (x0, y0, x1, y1, role, _a) in ps:\n",
    "        color = (0, 255, 0) if role == \"thermal\" else (255, 150, 0)\n",
    "        cv2.rectangle(vis, (x0, y0), (x1, y1), color, 2)\n",
    "    ax.imshow(cv2.cvtColor(vis, cv2.COLOR_BGR2RGB))\n",
    "    ax.set_title(f\"{t}  ({PAD_COUNT[t]}-pad)\")\n",
