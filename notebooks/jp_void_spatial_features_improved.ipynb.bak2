    "plt.rcParams[\"figure.dpi\"] = 110\n",
    "\n",
    "DATA_DIR = Path(r\"../data/raw/XRay/XRay\").resolve()\n",
    "assert DATA_DIR.is_dir(), f\"Data directory not found: {DATA_DIR}\"\n",
    "LED_TYPES = sorted([p.name for p in DATA_DIR.iterdir() if p.is_dir()])\n",
