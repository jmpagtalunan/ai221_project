    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "210611c1",
   "metadata": {},
   "source": [
    "## 4. Void mask extraction\n",
    "\n",
    "A plain `DUT − reference` does not work on these images: exposure and blur differ from shot to shot, solder thickness adds slow brightness gradients, and die / bumps / wire bonds sit in slightly different places relative to the pads. All of that ends up in the difference image and is larger than the void signal.\n",
    "\n",
    "So the reference is fitted to each DUT **locally** before subtracting (window of about 8 px):\n",
    "\n",
    "`DUT ≈ b + a·ref + c·∂ref/∂x + d·∂ref/∂y + e·∇²ref`\n",
    "\n",
    "- `a, b` absorb local brightness/contrast, `c, d` a local sub-pixel shift, `e` a blur difference.\n",
    "- Voids are not in the reference, so they remain in the residual. Outlier pixels are removed from the fit and the fit is repeated, so voids do not bias it.\n",
    "- Residual → hysteresis threshold `T` (per LED type, see `VOID_T`) → drop blobs under 8 px and long thin blobs (pad-outline offsets, edges of shifted structures).\n",
    "\n",
    "The void ratio is `void pixels / pad pixels`, the same definition as in `Xray Void Ratio.csv`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 136,
   "id": "4e0ecf25",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-15T15:41:34.327655Z",
     "iopub.status.busy": "2026-11-15T15:41:34.327382Z",
     "iopub.status.idle": "2026-11-15T15:41:35.803462Z",
     "shell.execute_reply": "2026-11-15T15:41:35.802631Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1430x1210 with 12 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from skimage.filters import apply_hysteresis_threshold\n",
    "\n",
    "_K3 = np.ones((3, 3), np.uint8)\n",
    "\n",
    "# Detection threshold per LED type, in grey levels of the reference image.\n",
    "# Calibrated once against data/raw/CrackVoid Ratios/Xray Void Ratio.csv (value with the smallest mean absolute\n",
    "# error of the per-LED void ratio). Re-run calibrate_threshold() further below if the pipeline changes.\n",
    "VOID_T = {\"FC-GB1\": 11, \"FC-GB2\": 16, \"FC-GB3\": 14, \"FC-SP1\": 11, \"FC-SP2\": 13,\n",
    "          \"FC-SP3\": 12, \"FC-SP4\": 13, \"VTF1\": 10, \"VTF2\": 12}\n",
    "\n",
    "\n",
    "# ---------- 1. local fit of the DUT to the reference ----------\n",
    "def _ref_features(ref):\n",
    "    \"\"\"Regressors: 1, ref, d(ref)/dx, d(ref)/dy, laplacian(ref).\"\"\"\n",
    "    r = cv2.GaussianBlur(ref.astype(np.float32), (0, 0), 1.0)\n",
    "    return np.stack([np.ones_like(r), ref.astype(np.float32),\n",
    "                     cv2.Sobel(r, cv2.CV_32F, 1, 0, ksize=3) / 8, cv2.Sobel(r, cv2.CV_32F, 0, 1, ksize=3) / 8,\n",
    "                     cv2.Laplacian(r, cv2.CV_32F, ksize=3)], axis=-1)\n",
    "\n",
    "\n",
    "MIN_POLYFIT_POINTS = 32   # minimum mask pixels required for a reliable polyfit\n",
    "\n",
    "\n",
    "def _global_gain(img, ref, mask):\n",
    "    \"\"\"Robust slope/offset of img against ref = contrast of this shot relative to the reference.\n",
    "\n",
    "    Returns (a, b) where img ~= a * ref + b inside the mask.\n",
    "    Falls back to (1.0, 0.0) if the mask contains fewer than MIN_POLYFIT_POINTS pixels.\n",
    "    \"\"\"\n",
    "    import warnings as _warnings\n",
    "    x, y = ref[mask > 0], img[mask > 0]\n",
    "    if x.size < MIN_POLYFIT_POINTS:\n",
    "        _warnings.warn(\n",
    "            f\"_global_gain: only {x.size} mask pixels \"\n",
    "            f\"(< MIN_POLYFIT_POINTS={MIN_POLYFIT_POINTS}); \"\n",
    "            \"falling back to gain=1.0, offset=0.0.\",\n",
    "            RuntimeWarning, stacklevel=2,\n",
    "        )\n",
    "        return 1.0, 0.0\n",
    "    keep = np.ones_like(x, bool)\n",
    "    for _ in range(3):\n",
    "        a, b = np.polyfit(x[keep], y[keep], 1)\n",
    "        res = y - (a * x + b)\n",
    "        s = 1.4826 * np.median(np.abs(res[keep] - np.median(res[keep]))) + 1e-6\n",
    "        keep = np.abs(res) < 2.5 * s\n",
    "    return a, b\n",
    "\n",
    "\n",
    "def _local_residual(img, X, fit_mask, a0, sigma_w=8.0, n_iter=3, k_out=2.0, ridge=4.0):\n",
    "    \"\"\"Inside a Gaussian window (sigma_w px) around every pixel fit\n",
    "           img ~ b + a*ref + c*dref/dx + d*dref/dy + e*lap(ref)\n",
    "       b, a : local brightness / contrast     (exposure differences, solder-thickness gradients)\n",
    "       c, d : local sub-pixel shift           (die, bumps and wire bonds move a little relative to the pads)\n",
    "       e    : blur difference\n",
    "    Voids are not in the reference, so they are what is left over. Outliers are removed from the fit and\n",
    "    the fit is repeated, so the voids themselves do not pull the local brightness up.\"\"\"\n",
    "    H, W, K = X.shape\n",
    "    ys, xs = np.nonzero(fit_mask)\n",
    "    w = fit_mask.astype(np.float32)\n",
    "    lam = np.full(K, ridge, np.float32); lam[0] = 0.0\n",
    "    beta0 = np.zeros(K, np.float32); beta0[1] = a0                    # shrink towards the global contrast\n",
    "    for _ in range(n_iter):\n",
    "        mw = cv2.GaussianBlur(w, (0, 0), sigma_w)[ys, xs] + 1e-6\n",
    "        A = np.zeros((len(ys), K, K), np.float32)\n",
    "        for i, j in zip(*np.triu_indices(K)):\n",
    "            v = cv2.GaussianBlur(w * X[..., i] * X[..., j], (0, 0), sigma_w)[ys, xs] / mw\n",
    "            A[:, i, j] = v; A[:, j, i] = v\n",
    "        rhs = np.stack([cv2.GaussianBlur(w * X[..., i] * img, (0, 0), sigma_w)[ys, xs] / mw for i in range(K)], -1)\n",
    "        A[:, np.arange(K), np.arange(K)] += lam\n",
    "        rhs += lam * beta0\n",
    "        beta = np.linalg.solve(A.astype(np.float64), rhs[..., None].astype(np.float64))[..., 0]\n",
    "        resid = np.zeros((H, W), np.float32)\n",
    "        resid[ys, xs] = img[ys, xs] - (beta * X[ys, xs]).sum(-1)\n",
    "        r = resid[ys, xs]\n",
    "        s = 1.4826 * np.median(np.abs(r - np.median(r))) + 1e-6\n",
    "        out = cv2.dilate(((resid > k_out * s) & (fit_mask > 0)).astype(np.uint8), _K3)     # bright outliers (voids)\n",
    "        out |= ((resid < -2 * k_out * s) & (fit_mask > 0)).astype(np.uint8)                # strong dark outliers\n",
    "        w = ((fit_mask > 0) & (out == 0)).astype(np.float32)\n",
    "    return resid\n",
    "\n",
    "\n",
    "# ---------- 2. everything that is computed once per LED type ----------\n",
    "def build_void_context(led_type, tsc=0):\n",
    "    imgs, meta_rows = load_led_type(led_type, tsc)\n",
    "    reg = register_led_type(imgs, led_type=led_type)\n",
    "    ref = reg[\"reference\"]\n",
    "    pads_bbox, per_pad = detect_pads(np.clip(ref, 0, 255).astype(np.uint8), led_type)\n",
    "    pad = np.zeros(ref.shape, np.uint8)\n",
    "    for m in per_pad:\n",
    "        pad |= (m > 0).astype(np.uint8)\n",
    "    # small, very dark features of the package (bump grid, vias, wire-bond balls): never solder -> ignored\n",
    "    pad_level = np.median(ref[cv2.erode(pad, _K3, iterations=3) > 0])\n",
    "    blackhat = cv2.morphologyEx(ref, cv2.MORPH_BLACKHAT, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (11, 11)))\n",
    "    dark = cv2.dilate((blackhat > max(8.0, 0.3 * pad_level)).astype(np.uint8), _K3, iterations=2)\n",
    "    detect_region = cv2.erode(pad, _K3, iterations=2)                 # stay 2 px away from the pad outline\n",
    "    return dict(led_type=led_type, meta=meta_rows, aligned=reg[\"aligned\"], valid=reg[\"valid\"], ok=reg[\"ok\"],\n",
    "                reference=ref, pads=pads_bbox, pad_masks=per_pad, pad=pad, dark=dark, X=_ref_features(ref),\n",
    "                fit_region=cv2.dilate(pad, _K3, iterations=4), detect_region=detect_region,\n",
    "                edge_dist=ndi.distance_transform_edt(detect_region))\n",
    "\n",
    "\n",
    "def void_residual(ctx, i):\n",
    "    \"\"\"Residual of DUT i (grey levels of the reference; positive = brighter than expected = less metal).\"\"\"\n",
    "    img = ctx[\"aligned\"][i]\n",
    "    fit = ctx[\"fit_region\"] & ctx[\"valid\"][i] & (1 - ctx[\"dark\"])\n",
    "    import warnings as _warnings\n",
    "    a0, _ = _global_gain(img, ctx[\"reference\"], ctx[\"fit_region\"] & ctx[\"valid\"][i])\n",
    "    resid = _local_residual(img, ctx[\"X\"], fit, a0)\n",
    "    if a0 <= 0.05:\n",
    "        _warnings.warn(\n",
    "            f\"void_residual (i={i}): global gain a0={a0:.4f} <= 0.05 \"\n",
    "            \"(inverted or degenerate contrast); skipping normalisation, \"\n",
    "            \"returning raw residual.\",\n",
    "            RuntimeWarning, stacklevel=2,\n",
    "        )\n",
    "        return resid\n",
    "    return resid / a0\n",
    "\n",
    "\n",
    "# ---------- 3. residual -> void mask ----------\n",
    "def extract_void_mask(ctx, i, T=None, hyst=0.6, min_area=8, resid=None):\n",
    "    \"\"\"Binary void mask (0/1) of DUT i of the LED type described by ctx.\n",
    "\n",
    "    T         : threshold in grey levels (default: calibrated VOID_T of this LED type)\n",
    "    hyst      : a blob must exceed T somewhere and is then grown down to hyst*T (hysteresis)\n",
    "    min_area  : smallest void in pixels (the reference data contains no void smaller than 8 px)\n",
    "    Blobs that are long and thin are dropped: along the pad outline they are solder/pad offsets, elsewhere\n",
    "    they are edges of shifted internal structures - neither is a void.\n",
    "    \"\"\"\n",
    "    if not ctx[\"ok\"][i]:\n",
    "        return np.zeros(ctx[\"pad\"].shape, np.uint8)\n",
    "    T = VOID_T[ctx[\"led_type\"]] if T is None else T\n",
    "    R = void_residual(ctx, i) if resid is None else resid\n",
    "    region = ctx[\"detect_region\"] & ctx[\"valid\"][i] & (1 - ctx[\"dark\"])\n",
    "    lbl = label(apply_hysteresis_threshold(np.where(region > 0, R, -99), hyst * T, T), connectivity=2)\n",
    "    mask = np.zeros(R.shape, np.uint8)\n",
    "    for r in regionprops(lbl):\n",
    "        if r.area < min_area:\n",
    "            continue\n",
    "        elong = r.axis_major_length / max(r.axis_minor_length, 1.0)\n",
    "        near_edge = (ctx[\"edge_dist\"][r.coords[:, 0], r.coords[:, 1]] <= 3).mean()\n",
    "        if (elong >= 3 and near_edge >= 0.6) or (elong >= 4 and r.axis_major_length >= 30):\n",
    "            continue\n",
    "        mask[lbl == r.label] = 1\n",
    "    return mask\n",
    "\n",
    "\n",
    "def void_stats(ctx, i, mask):\n",
    "    \"\"\"Same quantities as the columns of Xray Void Ratio.csv.\"\"\"\n",
    "    pad_px = int((ctx[\"pad\"] & ctx[\"valid\"][i]).sum())\n",
    "    void_px = int(mask.sum())\n",
    "    return dict(pad_px=pad_px, void_count=int(label(mask).max()), void_px=void_px,\n",
    "                void_ratio=void_px / pad_px if ctx[\"ok\"][i] and pad_px else np.nan)\n",
    "\n",
    "\n",
    "def draw_void_outlines(dut_img, void_mask, pads_bbox=None,\n",
    "                       void_color=(0, 0, 255), pad_color=(0, 255, 0),\n",
    "                       thickness=1):\n",
    "    \"\"\"Return a color image of the DUT with void contours (red) and optional pad boxes (green).\"\"\"\n",
    "    vis = cv2.cvtColor(np.clip(dut_img, 0, 255).astype(np.uint8), cv2.COLOR_GRAY2BGR)\n",
    "    contours, _ = cv2.findContours((void_mask > 0).astype(np.uint8),\n",
    "                                   cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "    cv2.drawContours(vis, contours, -1, void_color, thickness)\n",
    "    if pads_bbox is not None:\n",
    "        for (x0, y0, x1, y1, _r, _a) in pads_bbox:\n",
    "            cv2.rectangle(vis, (x0, y0), (x1, y1), pad_color, 1)\n",
    "    return vis, len(contours)\n",
    "\n",
    "\n",
    "# ---------- reference values (paper's own per-LED result) ----------\n",
    "GT_CSV = Path(\"../data/raw/CrackVoid Ratios/Xray Void Ratio.csv\")\n",
    "gt_df = pd.read_csv(GT_CSV, sep=\";\", na_values=[\"---\"])\n",
    "gt_df.columns = [\"led_type\", \"paste\", \"panel\", \"led_num\", \"csv_pad_px\", \"csv_void_count\", \"csv_void_px\", \"csv_void_ratio\"]\n",
    "_KEY = [\"led_type\", \"paste\", \"panel\", \"led_num\"]\n",
    "_dup_mask = gt_df.duplicated(_KEY, keep=False)\n",
    "if _dup_mask.any():\n",
    "    import logging as _logging\n",
    "    _logging.warning(\n",
    "        \"CSV dedup: dropping %d duplicate-key rows (keeping first occurrence). \"\n",
    "        \"Affected keys:\\n%s\",\n",
    "        _dup_mask.sum(),\n",
    "        gt_df[_dup_mask][_KEY].drop_duplicates().to_string(),\n",
    "    )\n",
    "gt_df = gt_df.drop_duplicates(_KEY, keep='first')          # FC-SP4 / SAC105 / panel 2 lists LED 7 twice -> keep first, log dropped\n",
    "\n",
    "\n",
    "# ---------- demo on FC-SP3: raw DUT | residual | outlined voids ----------\n",
    "ctx = build_void_context(\"FC-SP3\")\n",
    "aligned = [np.clip(a, 0, 255).astype(np.uint8) for a in ctx[\"aligned\"]]\n",
    "reference = np.clip(ctx[\"reference\"], 0, 255).astype(np.uint8)\n",
    "pads, pad_masks = ctx[\"pads\"], ctx[\"pad_masks\"]\n",
    "csv_sp3 = pd.DataFrame(ctx[\"meta\"]).merge(gt_df, on=_KEY, how=\"left\")[\"csv_void_ratio\"].values\n",
    "\n",
    "fig, ax = plt.subplots(3, 4, figsize=(13, 11))\n",
    "for c, idx in enumerate([0, 25, 75, 150]):\n",
    "    R = void_residual(ctx, idx)\n",
    "    mask = extract_void_mask(ctx, idx, resid=R)\n",
    "    st = void_stats(ctx, idx, mask)\n",
    "    vis, n_voids = draw_void_outlines(aligned[idx], mask, pads_bbox=pads)\n",
    "    ax[0, c].imshow(aligned[idx], cmap=\"gray\"); ax[0, c].set_title(f\"DUT {idx}\")\n",
    "    ax[1, c].imshow(np.where(ctx[\"detect_region\"] > 0, R, np.nan), cmap=\"RdBu_r\", vmin=-25, vmax=25)\n",
    "    ax[1, c].set_title(\"residual after local fit (red = brighter)\")\n",
    "    ax[2, c].imshow(cv2.cvtColor(vis, cv2.COLOR_BGR2RGB))\n",
    "    ax[2, c].set_title(f\"{n_voids} voids, ratio {100*st['void_ratio']:.1f} %  (CSV {100*csv_sp3[idx]:.1f} %)\")\n",
    "    for r in range(3):\n",
    "        ax[r, c].axis(\"off\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
