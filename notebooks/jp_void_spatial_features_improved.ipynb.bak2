    "# Cache references per LED type for reuse in later sections.\n",
    "# Prints per-type status and catches errors so one bad type does not kill the whole cell.\n",
    "REFS = {}\n",
    "\n",
    "fig, axes = plt.subplots(3, 3, figsize=(10, 10))\n",
    "for ax, t in zip(axes.flat, LED_TYPES):\n",
    "    try:\n",
    "        imgs, _ = load_led_type(t)\n",
    "        if not imgs:\n",
    "            ax.text(0.5, 0.5, f\"{t}NO IMAGES\", ha=\"center\", va=\"center\")\n",
    "            ax.axis(\"off\")\n",
    "            print(f\"{t}: NO IMAGES at TSC=0\")\n",
    "            continue\n",
    "        ref, _ = compute_reference(imgs)\n",
    "        REFS[t] = ref\n",
    "        ax.imshow(ref, cmap=\"gray\", vmin=0, vmax=255)\n",
    "        ax.set_title(f\"{t}  (n={len(imgs)})\")\n",
    "        ax.axis(\"off\")\n",
    "        print(f\"{t}: n={len(imgs)} shape={imgs[0].shape} ref min={ref.min()} max={ref.max()}\")\n",
    "    except Exception as e:\n",
    "        ax.text(0.5, 0.5, f\"{t}{type(e).__name__}\", ha=\"center\", va=\"center\", color=\"red\")\n",
    "        ax.axis(\"off\")\n",
    "        print(f\"{t}: ERROR {type(e).__name__}: {e}\")\n",
    "# Hide any unused subplots if LED_TYPES has fewer than 9 entries\n",
    "for ax in list(axes.flat)[len(LED_TYPES):]:\n",
    "    ax.axis(\"off\")\n",
    "\n",
    "plt.suptitle(\"Reference image per LED type\", y=1.02)\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "print(\"Reference contrast (max - min intensity) per LED type:\")\n",
    "for t, r in REFS.items():\n",
    "    print(f\"  {t:>7s}: min={r.min():3d}, max={r.max():3d}, range={int(r.max())-int(r.min()):3d}\")\n"
   ]
