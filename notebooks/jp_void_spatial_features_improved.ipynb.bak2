    }
   ],
   "source": [
    "def is_placeholder(img):\n",
    "    \"\"\"Some files are not X-rays but a white picture with the word 'Missing'. They must not enter the reference.\"\"\"\n",
    "    return (img >= 250).mean() > 0.6\n",
    "\n",
    "\n",
    "def _coarse_shift(img, tmpl, box, search=60):\n",
    "    \"\"\"Full-range translation search: where does the central crop of the template sit in img?\"\"\"\n",
    "    x0, y0, x1, y1 = box\n",
    "    padded = cv2.copyMakeBorder(img, search, search, search, search, cv2.BORDER_REPLICATE)\n",
    "    res = cv2.matchTemplate(padded, tmpl[y0:y1, x0:x1], cv2.TM_CCOEFF_NORMED)\n",
    "    _, score, _, loc = cv2.minMaxLoc(res)\n",
    "    return loc[0] - search - x0, loc[1] - search - y0, score\n",
    "\n",
    "\n",
    "def register_image(img, tmpl, box, affine=True):\n",
    "    \"\"\"Align img to tmpl. Coarse template search -> ECC (shift + rotation) -> ECC affine (also scale: the\n",
    "    magnification differs by about +-1.5 % between shots). Returns (aligned, valid, score); valid = 1 where\n",
    "    the aligned pixel really came from inside the original frame.\"\"\"\n",
    "    img, tmpl = img.astype(np.float32), tmpl.astype(np.float32)\n",
    "    dx, dy, score = _coarse_shift(img, tmpl, box)\n",
    "    warp = np.float32([[1, 0, dx], [0, 1, dy]])\n",
    "    crit = (cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 80, 1e-6)\n",
    "    try:\n",
    "        _, warp = cv2.findTransformECC(tmpl, img, warp, cv2.MOTION_EUCLIDEAN, crit, None, 5)\n",
    "    except cv2.error:\n",
    "        pass\n",
    "    if affine:\n",
    "        try:\n",
    "            _, w2 = cv2.findTransformECC(tmpl, img, warp.copy(), cv2.MOTION_AFFINE, crit, None, 5)\n",
    "            sx, sy = np.hypot(w2[0, 0], w2[1, 0]), np.hypot(w2[0, 1], w2[1, 1])\n",
    "            if 0.94 < sx < 1.06 and 0.94 < sy < 1.06:      # sanity limits on the scale\n",
    "                warp = w2\n",
    "        except cv2.error:\n",
    "            pass\n",
    "    size, flags = tmpl.shape[::-1], cv2.INTER_LINEAR + cv2.WARP_INVERSE_MAP\n",
    "    out = cv2.warpAffine(img, warp, size, flags=flags, borderMode=cv2.BORDER_REPLICATE)\n",
    "    valid = cv2.warpAffine(np.ones(img.shape, np.float32), warp, size, flags=flags,\n",
    "                           borderMode=cv2.BORDER_CONSTANT, borderValue=0)\n",
    "    return out, (valid > 0.999).astype(np.uint8), score\n",
    "\n",
    "\n",
    "_REG_CACHE = {}\n",
    "\n",
    "\n",
    "def register_led_type(images, n_pass=3, led_type=None):\n",
    "    \"\"\"Register all images of one LED type to a common frame and build the void-less reference.\n",
    "\n",
    "    Pass 1 aligns to the first real image, later passes align to the MEDIAN of the previous pass\n",
    "    (the median ignores voids and outliers better than the mean). The last pass also fits scale.\n",
    "    Returns dict(aligned (N,H,W) float32, valid (N,H,W) uint8, ok (N,) bool, score, reference float32).\n",
    "    \"\"\"\n",
    "    key = (led_type, images[0].shape, len(images))\n",
    "    if key in _REG_CACHE:\n",
    "        return _REG_CACHE[key]\n",
    "    ok = np.array([not is_placeholder(im) for im in images])\n",
    "    smooth = [cv2.GaussianBlur(im.astype(np.float32), (0, 0), 0.8) for im in images]\n",
    "    tmpl = cv2.GaussianBlur(images[int(np.argmax(ok))].astype(np.float32), (0, 0), 1.0)\n",
    "    h, w = tmpl.shape\n",
    "    box = (int(0.12 * w), int(0.12 * h), int(0.88 * w), int(0.88 * h))\n",
    "    for it in range(n_pass):\n",
    "        res = [register_image(s, tmpl, box, affine=(it == n_pass - 1)) for s in smooth]\n",
    "        stack = np.stack([r[0] for r in res])\n",
    "        score = np.array([r[2] for r in res])\n",
    "        tmpl = np.median(stack[ok & (score > 0.5)], axis=0).astype(np.float32)\n",
    "    out = dict(aligned=stack, valid=np.stack([r[1] for r in res]), ok=ok, score=score, reference=tmpl)\n",
    "    _REG_CACHE[key] = out\n",
    "    return out\n",
    "\n",
    "\n",
    "def compute_reference(images):\n",
    "    \"\"\"Kept for the cells below: returns (reference uint8, list of aligned uint8 images).\"\"\"\n",
    "    reg = register_led_type(images)\n",
    "    ref = np.clip(reg[\"reference\"], 0, 255).astype(np.uint8)\n",
    "    return ref, [np.clip(a, 0, 255).astype(np.uint8) for a in reg[\"aligned\"]]\n",
    "\n",
    "\n",
    "# FC-SP3 DUT vs. reference (close-up sanity check)\n",
    "reference, aligned = compute_reference(images)\n",
    "reg_demo = register_led_type(images)\n",
    "print(f\"placeholder ('Missing') images: {int((~reg_demo['ok']).sum())},  lowest match score: {reg_demo['score'][reg_demo['ok']].min():.2f}\")\n",
    "fig, ax = plt.subplots(1, 3, figsize=(10, 3.4))\n",
    "ax[0].imshow(aligned[0],  cmap=\"gray\", vmin=0, vmax=255); ax[0].set_title(\"FC-SP3  DUT 1 (aligned)\")\n",
    "ax[1].imshow(aligned[20], cmap=\"gray\", vmin=0, vmax=255); ax[1].set_title(\"FC-SP3  DUT 20 (aligned)\")\n",
    "ax[2].imshow(reference,  cmap=\"gray\", vmin=0, vmax=255); ax[2].set_title(\"FC-SP3  reference (median of 200)\")\n",
    "for a in ax:\n",
    "    a.axis(\"off\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
